{
  "name": "@jackadamson/inkdeck",
  "version": "0.0.1",
  "description": "React renderer for Elgato Stream Deck \u2014 Ink, but the terminal is a grid of LCD keys",
  "keywords": [
    "stream-deck",
    "streamdeck",
    "elgato",
    "react",
    "react-renderer",
    "bun",
    "hid",
    "usb"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jackadamson/inkdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackadamson/inkdeck.git",
    "directory": "packages/inkdeck"
  },
  "bugs": {
    "url": "https://github.com/jackadamson/inkdeck/issues"
  },
  "type": "module",
  "bin": {
    "inkdeck": "src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/raster/assets/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test/**",
    "!src/raster/golden.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@takumi-rs/core": "^2.5.4",
    "react-reconciler": "0.32.0"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-reconciler": "^0.32.0",
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0",
    "react": "^19.1.0"
  }
}
