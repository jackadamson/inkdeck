// Harness-based test (no hardware): frozen time, deterministic taps.

import { describe, expect, test } from 'bun:test'
import { renderDeck } from '@jackadamson/inkdeck/testing'
import App from './app.tsx'
import mocks from './mocks.json'

describe('counter app', () => {
  test('increments, decrements, and resets on long-press', async () => {
    const deck = await renderDeck(<App />, { model: 'mk2', freezeTime: true, mockExec: mocks })
    expect(deck.key(0).text).toEqual(['count', '0'])
    expect(deck.key(1).hasPress).toBe(true)

    await deck.tap(1)
    await deck.tap(1)
    await deck.tap(2)
    await deck.settled()
    expect(deck.key(0).text).toEqual(['count', '1'])

    // Long-press key 0: hold past longPressMs (frozen clock advances through the tap).
    await deck.tap(0, 700)
    await deck.settled()
    expect(deck.key(0).text).toEqual(['count', '0'])

    // This app runs no subprocesses; if you add exec() calls, mock them in mocks.json.
    expect(deck.unmatchedExecs).toEqual([])
    await deck.shutdown()
  })
})
